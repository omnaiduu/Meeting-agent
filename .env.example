# Copy to .env and fill in. Real environment variables win over this file.
HTTP_ADDR=:8080
DATA_DIR=./data
LOG_LEVEL=info

# Groq (speech-to-text + summary). Leave empty to run with fake providers.
GROQ_API_KEY=
GROQ_STT_MODEL=whisper-large-v3-turbo
GROQ_SUMMARY_MODEL=openai/gpt-oss-120b
# STT_PROVIDER=groq      # groq | fake (default: groq if key set)
# SUMMARY_PROVIDER=groq  # groq | fake
# STT_LANGUAGE=en

# Bot
BOT_NAME=Meeting Agent (Notetaker)
# CHROME_PATH=/usr/bin/google-chrome
MAX_CONCURRENT_BOTS=2
LOBBY_TIMEOUT=10m
ALONE_TIMEOUT=2m
MAX_MEETING_DURATION=2h
CHUNK_SECONDS=20

# Dev only
# DEV_CORS=true

# Demo / containers
# ALLOWED_MEETING_HOSTS=meet.google.com,localhost:9090   # add the fake Meet (go run ./cmd/fakemeet)
# CHROME_HEADLESS=true      # only works with the fake Meet; real Meet blocks headless Chrome
# CHROME_NO_SANDBOX=true    # needed in most Docker setups
